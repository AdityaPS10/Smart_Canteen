# ---- App ----
# Public base URL of this app (used inside the entrance QR link: <APP_URL>/scan?t=TOKEN)
APP_URL=http://localhost:3000
# Show "Login as student / food server / cashier" buttons (true|false). Default off.
DEMO_MODE=false

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key: browser only uses it to LISTEN to Realtime broadcast signals (tables have RLS with no policies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret   (or any 32+ random chars)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only Google accounts ending in @<this domain> may sign in (e.g. mycollege.edu)
COLLEGE_EMAIL_DOMAIN=mycollege.edu
# Required by Auth.js when running behind a proxy / non-Vercel host
AUTH_TRUST_HOST=true

# ---- Secrets for QR codes, kiosks and cron ----
# Signs the rotating entrance QR (jose HS256). 32+ random chars.
QR_SECRET=
# Key required in the URL of /tv/board, /tv/menu and /entrance (?key=...)
KIOSK_KEY=
# Bearer token for POST /api/cron/tick
CRON_SECRET=

# ---- Payments ----
# razorpay | mock   (falls back to mock automatically when Razorpay keys are missing)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Time prediction service (/ml) ----
ML_URL=http://localhost:8000
